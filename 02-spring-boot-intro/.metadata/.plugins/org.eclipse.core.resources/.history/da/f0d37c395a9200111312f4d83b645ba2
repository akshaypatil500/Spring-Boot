package com.tca.runner;

import java.util.List;

import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.stereotype.Component;

@Component
public class MyRunner implements ApplicationRunner{

	@Override
	public void run(ApplicationArguments args) throws Exception {

            List<String> list=args.getNonOptionArgs();	
            System.out.println("Non-Option Args List :"+list);
            
            if(args.containsOption("admin.user"))
            {
           List<String> list2=args.getOptionValues("admin.user");
           System.out.println("Option Args List :"+list2);
            }
            else
            {
            	  System.out.println("No Admin-User Send");
            }

           
            
            
	}

}
