package com.tca.runner;

import java.util.List;
import java.util.Set;

import org.springframework.boot.ApplicationArguments;
import org.springframework.boot.ApplicationRunner;
import org.springframework.stereotype.Component;

@Component
public class MyRunner implements ApplicationRunner {

	@Override
	public void run(ApplicationArguments args) throws Exception {
	
		Set<String> keys = args.getOptionNames();

		for(String key : keys)
		{
		    if(key.equalsIgnoreCase("theme-mode"))
		    {
		        String value = args.getOptionValues(key).get(0);

		        if(value.equalsIgnoreCase("dark"))
		        {
		            System.out.println("Dark Mode Activated");
		        }
		        else
		        {
		            System.out.println("Light Mode Activated");
		        }
		    }
		}
	
		

	

	}


