//Double Checking with thread Safety using Synchronized Block

package com.tca.service;

public class Car {
	
	 private static Car ob=null;
	 
	 private Car() {}
	 
	 public static Car getInstance()
	 {
		 if(ob==null)
		 {
			synchronized(Car.class)  
			{ 
		     if(ob==null)   //t2 will check will get false then won't go directly return existing ob
		     {
			 ob=new Car();
		     }
		    }
	     }
		 return ob;                   // Return Existing Object
	 }
		
	 }
	 
